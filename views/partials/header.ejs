<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link href="https://cdn.jsdelivr.net/npm/remixicon@4.2.0/fonts/remixicon.css" rel="stylesheet" />
    <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="font-['helvetica_now_display']">
    <nav class="w-full px-5 py-3 flex justify-between items-center">
        <h3 class="text-xl">SHOP SEE</h3>
        <% var loggedIn = typeof loggedIn !== 'undefined' ? loggedIn : true; %>
        <div class="flex gap-5">
            <% if (loggedIn) { %>
                <a href="/shop" class="text-black hover:text-gray-600">Shop</a>
                <a href="/cart" class="text-black hover:text-gray-600">Cart</a>
                <a href="/account" class="text-black hover:text-gray-600">My Account</a>
                <a href="/users/logout" class="text-red-500 hover:text-gray-600">Logout</a>
            <% }  %>
        </div>
    </nav>
</body>

</html>
