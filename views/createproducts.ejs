<%- include('./partials/header') %>

<% if(success.length>0){ %>
    <div class="absolute top-5 left-1/2 -translate-x-1/2 -translate-y-1/2 p-4 rounded-md bg-blue-600 shadow-lg">
        <span class="inline-block text-white text-lg font-semibold">
            <%= success %>
        </span>
    </div>
<% } %>

<div class="min-h-screen flex flex-col bg-gray-50">
    <div class="container px-10 py-20 flex flex-grow">
        <!-- Sidebar -->
        <div class="w-[25%] flex h-screen flex-col bg-white shadow-md rounded-lg p-5">
            <div class="flex flex-col space-y-4">
                <a class="text-xl font-semibold text-blue-600 hover:text-blue-800" href="/shop">All Products</a>
                <a class="text-xl font-semibold text-blue-600 hover:text-blue-800" href="">Create New Product</a>
            </div>
        </div>
        
        <!-- Main Content -->
        <main class="w-3/4 bg-white p-10 rounded-lg shadow-lg ml-4">
            <h2 class="text-2xl font-bold mb-6 text-gray-800">Create New Product</h2>
            
            <!-- Product Form -->
            <form autocomplete="off" action="/products/create" method="post" enctype="multipart/form-data">
                <div class="mb-8">
                    <h3 class="text-xl font-semibold mb-4 text-gray-700">Product Details</h3>
                    
                    <!-- Image Upload -->
                    <div class="mb-6">
                        <label class="block mb-2 text-lg font-medium text-gray-700">Product Image</label>
                        <input name="image" type="file" class="py-3 px-5 rounded-md border border-gray-300 w-full bg-gray-50 hover:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-500 transition">
                    </div>
                    
                    <!-- Name, Price, Discount Inputs -->
                    <div class="grid grid-cols-2 gap-6">
                        <input name="name" type="text" placeholder="Product Name"
                            class="border p-3 rounded-md w-full shadow-md focus:ring-2 focus:ring-blue-500">
                        <input name="price" type="number" placeholder="Product Price"
                            class="border p-3 rounded-md w-full shadow-md focus:ring-2 focus:ring-blue-500">
                        <input name="discount" type="number" placeholder="Discount Price"
                            class="border p-3 rounded-md w-full shadow-md focus:ring-2 focus:ring-blue-500">
                    </div>
                </div>

                <!-- Panel Details -->
                <div class="mb-8">
                    <h3 class="text-xl font-semibold mb-4 text-gray-700">Panel Details</h3>
                    <div class="grid grid-cols-2 gap-6">
                        <input name="bgcolor" type="text" placeholder="Background Color"
                            class="border p-3 rounded-md w-full shadow-md focus:ring-2 focus:ring-blue-500">
                        <input name="panelcolor" type="text" placeholder="Panel Color"
                            class="border p-3 rounded-md w-full shadow-md focus:ring-2 focus:ring-blue-500">
                        <input name="textcolor" type="text" placeholder="Text Color"
                            class="border p-3 rounded-md w-full shadow-md focus:ring-2 focus:ring-blue-500">
                    </div>
                </div>

                <!-- Submit Button -->
                <div class="flex justify-end">
                    <input class="px-8 py-3 rounded-md bg-blue-600 text-white font-semibold text-lg hover:bg-blue-700 transition" type="submit" value="Create New Product">
                </div>
            </form>
        </main>
    </div>
</div>

<%- include('./partials/footer') %>
