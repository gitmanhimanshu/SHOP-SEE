<%- include('./partials/header') %>

<% if(error.length>0){ %>
    <div class="absolute top-5 left-1/2 -translate-x-1/2 -translate-y-1/2 p-3 rounded-md bg-red-500 shadow-lg">
        <span class="inline-block mt-1 mb-1 text-white font-semibold">
            <%= error %>
        </span>
    </div>
<% } %>

<div class="w-full h-screen flex px-20 bg-gradient-to-r from-blue-500 to-purple-600">
    <div class="w-1/2 flex items-center justify-center h-screen">
        <div class="w-full px-32 bg-white p-10 rounded-lg shadow-lg">
            <h3 class="text-4xl text-blue-600">Welcome to <span class="text-yellow-400 font-semibold">SHOP SEE</span></h3>
            <h4 class="text-2xl mb-5 text-gray-700">Create your account</h4>
            <form autocomplete="off" action="/users/register" method="post">
                <input
                    class="bg-gray-100 block w-full px-3 py-2 border-[1px] rounded-md mb-3 border-gray-200 focus:outline-none focus:ring-2 focus:ring-blue-500"
                    type="text" placeholder="Full Name" name="fullname">
                <input
                    class="bg-gray-100 block w-full px-3 py-2 border-[1px] rounded-md mb-3 border-gray-200 focus:outline-none focus:ring-2 focus:ring-blue-500"
                    type="email" placeholder="Email" name="email">
                <input
                    class="bg-gray-100 block w-full px-3 py-2 border-[1px] rounded-md mb-3 border-gray-200 focus:outline-none focus:ring-2 focus:ring-blue-500"
                    type="password" placeholder="Password" name="password">
                <input class="px-5 rounded-full py-3 mt-2 bg-blue-500 text-white hover:bg-blue-600 transition duration-300" type="submit"
                    value="Create My Account">
            </form>
        </div>
    </div>
    
    <div class="w-1/2  ml-20 flex items-center justify-center h-screen">
        <div class="w-full px-32 bg-white p-10 rounded-lg shadow-lg">
            <h4 class="text-2xl capitalize mb-5 text-gray-700">Login to your account</h4>
            <form autocomplete="off" action="/users/login" method="post">
                <input
                    class="block bg-gray-100 w-full px-3 py-2 border-[1px] rounded-md mb-3 border-gray-200 focus:outline-none focus:ring-2 focus:ring-blue-500"
                    type="email" placeholder="Email" name="email">
                <input
                    class="block bg-gray-100 w-full px-3 py-2 border-[1px] rounded-md mb-3 border-gray-200 focus:outline-none focus:ring-2 focus:ring-blue-500"
                    type="password" placeholder="Password" name="password">
                <input class="px-5 block rounded-full py-3 mt-2 bg-blue-500 text-white hover:bg-blue-600 transition duration-300" type="submit"
                    value="Login">
            </form>
        </div>
    </div>
</div>

<%- include('./partials/footer') %>
