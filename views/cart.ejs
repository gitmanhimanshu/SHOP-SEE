<%- include('./partials/header') %>
<div class="w-full flex items-start px-20 py-20 gap-10">
    <!-- Product Display Section -->
    <div class="w-[30%] flex-shrink-0">
        <% user.cart.forEach(item => { %>
            <div class="rounded-md overflow-hidden bg-gray-100 mb-5">
                <div class="w-full h-[200px] bg-yellow-500">
                    <img class="h-full w-full object-cover" src="data:image/jpeg;base64,<%= item.image.toString('base64') %>" alt="Product Image">
                </div>
                
                <div class="w-full flex justify-between px-5 py-4 bg-[<%= item.panelcolor %>]">
                    <h3 class="text-2xl"><%= item.name %></h3>
                    <div class="flex items-center gap-2">
                        <i class="w-7 h-7 bg-white flex rounded-full items-center justify-center ri-add-line"></i>
                        <div class="px-2 py-1 rounded-md bg-[<%= item.textcolor %>] text-black"><%= Number(item.quantity) %></div>
                        <i class="w-7 h-7 bg-white flex rounded-full items-center justify-center ri-subtract-line"></i>
                    </div>
                </div>
                <div class="flex items-center justify-between px-5 py-3">
                    <h4 class="text-lg">Net Total</h4>
                    <h2 class="text-lg">₹ <%= (Number(item.price) * Number(item.quantity)) %></h2> <!-- Ensure price and quantity are numbers -->
                </div>
            </div>
        <% }); %>
    </div>

    <!-- Price Breakdown Section -->
    <div class="w-[70%] flex-grow">
        <% user.cart.forEach(item => { %>
            <div class="w-full bg-white p-5 rounded-md shadow-md mb-5">
                <h3 class="text-xl">Price Breakdown</h3>
                <div class="px-10 mt-5">
                    <div class="flex mt-2">
                        <h4 class="w-1/3">Total MRP</h4>
                        <h4>₹ <%= (Number(item.price) * Number(item.quantity)) %></h4> <!-- Ensure price and quantity are numbers -->
                    </div>
                    <div class="flex mt-2">
                        <h4 class="w-1/3">Discount on MRP</h4>
                        <h4>₹ <%= (Number(item.discount) || 0) %></h4> <!-- Use discount or 0 if not available, ensure discount is a number -->
                    </div>
                    <div class="flex mt-2">
                        <h4 class="w-1/3">Platform Fee</h4>
                        <h4>₹ 20</h4>
                    </div>
                    <div class="flex mt-2">
                        <h4 class="w-1/3">Shipping Fee</h4>
                        <h4>FREE</h4>
                    </div>
                </div>
                <div class="w-full h-[1px] bg-black mt-10"></div>
                <div class="flex mt-5">
                    <h3 class="w-1/3 text-xl">Total Amount</h3>
                    <h3 class="font-semibold text-xl text-green-600">₹ <%= (Number(item.price) * Number(item.quantity)) - (Number(item.discount) || 0) + 20 %></h3> <!-- Net Total after discount -->
                </div>
            </div>
        <% }); %>
    </div>
</div>
<%- include('./partials/footer') %>
